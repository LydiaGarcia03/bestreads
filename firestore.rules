rules_version = '2';

// Default: everything is denied. Each collection opens only what the app needs.
// Limits mirror the app: DISPLAY_NAME_MAX_LENGTH (src/features/auth/credentials.ts),
// PHOTO_URL_MAX_LENGTH (src/features/account/userDocument.ts), LIBRARY_LIMITS
// (src/features/books/library.ts) and the rating rules (src/features/books/rating.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admins are marked by an admins/{uid} document created by hand in the Firebase console.
    // For moderation of public data only (Phase 6+); never grants access to users/{uid}/...
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isNullableString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isValidPreferences(preferences) {
      return preferences is map
        && preferences.keys().hasOnly(['theme', 'language'])
        && preferences.keys().hasAll(['theme', 'language'])
        && preferences.theme in ['system', 'light', 'dark']
        && preferences.language in ['en', 'pt-BR'];
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'preferences', 'createdAt'])
        && data.keys().hasAll(['displayName', 'photoURL', 'preferences', 'createdAt'])
        && isNullableString(data.displayName, 100)
        && isNullableString(data.photoURL, 2048)
        && isValidPreferences(data.preferences)
        && data.createdAt is timestamp;
    }

    // users/{uid}: profile and preferences, owner only.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      // Account deletion is not supported yet.
      allow delete: if false;
    }

    // A multiple of 0.25 in (0, 5], or null when unrated.
    function isValidRating(rating) {
      return rating == null
        || (rating is number && rating > 0 && rating <= 5 && rating * 4 == math.floor(rating * 4));
    }

    function isValidProgress(progress) {
      return progress == null
        || (progress is map
          && progress.keys().hasOnly(['unit', 'value'])
          && progress.keys().hasAll(['unit', 'value'])
          && progress.unit in ['pages', 'percent']
          && progress.value is number
          && progress.value >= 0
          && (progress.unit == 'pages' || progress.value <= 100));
    }

    // A book's series (src/features/books/series.ts, SERIES_LIMITS), or null when not in one.
    function isValidSeries(series) {
      return series == null
        || (series is map
          && series.keys().hasOnly(['name', 'volume'])
          && series.keys().hasAll(['name', 'volume'])
          && series.name is string && series.name.size() > 0 && series.name.size() <= 100
          && (series.volume == null
            || (series.volume is number && series.volume >= 0 && series.volume <= 1000)));
    }

    // A reading plan (src/features/books/readingPlan.ts, PLAN_LIMITS), or null. Weekdays are
    // Date.getDay() values; a reminder needs a time.
    function isValidPlan(plan) {
      return plan == null
        || (plan is map
          && plan.keys().hasOnly(['pagesPerDay', 'time', 'weekdays', 'reminder'])
          && plan.keys().hasAll(['pagesPerDay', 'time', 'weekdays', 'reminder'])
          && plan.pagesPerDay is int && plan.pagesPerDay >= 1 && plan.pagesPerDay <= 1000
          && (plan.time == null
            || (plan.time is string && plan.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
          && plan.weekdays is list && plan.weekdays.size() >= 1
          && plan.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
          && plan.weekdays.toSet().size() == plan.weekdays.size()
          && plan.reminder is bool
          && (plan.reminder == false || plan.time != null));
    }

    function isValidBook(data) {
      let fields = ['title', 'subtitle', 'authors', 'coverUrl', 'description', 'pageCount', 'isbn',
        'publishedYear', 'source', 'status', 'shelfIds', 'rating', 'ratingPublic', 'progress', 'reads',
        'addedAt', 'updatedAt'];
      // Optional: books saved before personal covers, series and reading plans existed don't have them.
      let optional = ['hasPersonalCover', 'series', 'plan'];
      return data.keys().hasOnly(fields.concat(optional))
        && data.keys().hasAll(fields)
        && (!('hasPersonalCover' in data) || data.hasPersonalCover is bool)
        && (!('series' in data) || isValidSeries(data.series))
        // A plan only while the book is being read.
        && (!('plan' in data) || (isValidPlan(data.plan) && (data.plan == null || data.status == 'reading')))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && isNullableString(data.subtitle, 300)
        && data.authors is list && data.authors.size() <= 20
        && isNullableString(data.coverUrl, 2048)
        && isNullableString(data.description, 5000)
        && (data.pageCount == null || (data.pageCount is int && data.pageCount > 0))
        && isNullableString(data.isbn, 13)
        && (data.publishedYear == null || data.publishedYear is int)
        && data.source in ['googleBooks', 'openLibrary']
        && data.status in ['wantToRead', 'reading', 'read']
        && data.shelfIds is list && data.shelfIds.size() <= 50
        && isValidRating(data.rating)
        && data.ratingPublic is bool
        && isValidProgress(data.progress)
        && data.reads is list && data.reads.size() <= 100
        && data.addedAt is timestamp
        && data.updatedAt == request.time;
    }

    // users/{uid}/books/{bookId}: the user's library, owner only. bookId is the catalog id.
    match /users/{uid}/books/{bookId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidBook(request.resource.data)
        && request.resource.data.addedAt == request.time;
      allow update: if isOwner(uid)
        && isValidBook(request.resource.data)
        && request.resource.data.addedAt == resource.data.addedAt;
      allow delete: if isOwner(uid);
    }

    function bookExists(uid, bookId) {
      return exists(/databases/$(database)/documents/users/$(uid)/books/$(bookId));
    }

    // users/{uid}/books/{bookId}/private/review: the owner's review (src/features/books/review.ts,
    // REVIEW_MAX_LENGTH). Only for books in the library; never copied to public/.
    function isValidReview(data) {
      return data.keys().hasOnly(['text', 'updatedAt'])
        && data.keys().hasAll(['text', 'updatedAt'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 20000
        && data.updatedAt == request.time;
    }

    match /users/{uid}/books/{bookId}/private/review {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && bookExists(uid, bookId) && isValidReview(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // users/{uid}/books/{bookId}/private/cover: the owner's own cover photo, resized in the browser
    // (src/features/books/personalCover.ts, COVER_MAX_DATA_URL_LENGTH). Only for books in the library.
    function isValidCover(data) {
      return data.keys().hasOnly(['dataUrl', 'updatedAt'])
        && data.keys().hasAll(['dataUrl', 'updatedAt'])
        && data.dataUrl is string
        && data.dataUrl.size() <= 220000
        && data.dataUrl.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$')
        && data.updatedAt == request.time;
    }

    match /users/{uid}/books/{bookId}/private/cover {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && bookExists(uid, bookId) && isValidCover(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // A custom shelf (src/features/books/shelves.ts, SHELF_LIMITS). Books list it in shelfIds.
    function isValidShelf(data) {
      return data.keys().hasOnly(['name', 'order', 'createdAt'])
        && data.keys().hasAll(['name', 'order', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 50
        && data.order is number
        && data.createdAt is timestamp;
    }

    // users/{uid}/shelves/{shelfId}: the user's custom shelves, owner only.
    match /users/{uid}/shelves/{shelfId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidShelf(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && isValidShelf(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    // The slim public copy of a rating (src/features/books/rating.ts, publicRatingOf): nothing private.
    function isValidPublicRating(data) {
      let fields = ['title', 'authors', 'coverUrl', 'rating', 'ratedAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.authors is list && data.authors.size() <= 20
        && isNullableString(data.coverUrl, 2048)
        && data.rating != null && isValidRating(data.rating)
        && data.ratedAt == request.time;
    }

    // The private book, as it will be once the current write (batch) is applied.
    function bookAfterWrite(uid, bookId) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/books/$(bookId)).data;
    }

    // public/{uid}/ratings/{bookId}: ratings the owner made public, readable by any signed-in user.
    // Written in the same batch as the private book, which must be in the library, marked public
    // and hold the same rating, so the copy can't drift from the user's own data.
    match /public/{uid}/ratings/{bookId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid)
        && isValidPublicRating(request.resource.data)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/books/$(bookId))
        && bookAfterWrite(uid, bookId).ratingPublic == true
        && bookAfterWrite(uid, bookId).rating == request.resource.data.rating;
      allow delete: if isOwner(uid);
    }

    // admins/{uid}: a user can check whether they are an admin; nobody can write from the app.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
