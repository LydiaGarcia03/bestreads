# Firebase web config (Project settings > General > Your apps).
# Copy this file to .env.local and fill in the values. Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Google Books API key restricted to the app's HTTP referrers (Google Cloud console).
# Without it, searches use Google's shared anonymous quota and fall back to Open Library when it runs out.
VITE_GOOGLE_BOOKS_API_KEY=
